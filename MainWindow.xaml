<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NyxShield Cybersecurity Bot"
        Height="720"
        Width="980"
        MinHeight="640"
        MinWidth="900"
        Background="#101820">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#00D1D1"/>
            <Setter Property="Foreground" Value="#101820"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8F6F6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl Background="#101820"
                    BorderBrush="#00D1D1">

            <TabItem Header="Chat">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="ChatDisplay"
                             Grid.Row="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="15"
                             Background="#1B1B1B"
                             Foreground="LightGreen"
                             BorderBrush="#00D1D1"
                             FontFamily="Consolas"
                             AcceptsReturn="True"/>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox"
                                 Grid.Column="0"
                                 Height="40"
                                 FontSize="15"
                                 KeyDown="InputBox_KeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                Width="120"
                                Height="40"
                                Click="SendButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tasks">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Task title" FontWeight="SemiBold"/>
                        <TextBox x:Name="TaskTitleInput"
                                 Height="36"/>

                        <TextBlock Text="Description" FontWeight="SemiBold"/>
                        <TextBox x:Name="TaskDescriptionInput"
                                 Height="92"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>

                        <TextBlock Text="Reminder" FontWeight="SemiBold"/>
                        <TextBox x:Name="TaskReminderInput"
                                 Height="36"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add Task"
                                    Width="120"
                                    Click="AddTaskButton_Click"/>
                            <Button Content="Set Reminder"
                                    Width="130"
                                    Click="SetReminderButton_Click"/>
                            <Button Content="Mark Complete"
                                    Width="140"
                                    Click="CompleteTaskButton_Click"/>
                            <Button Content="Delete"
                                    Width="100"
                                    Click="DeleteTaskButton_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="TaskStatusText"
                                   Margin="4,12,4,4"
                                   Foreground="#A7F3D0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Stored cybersecurity tasks"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <ListBox x:Name="TaskList"
                                 Grid.Row="1"
                                 Margin="4"
                                 Background="#1B1B1B"
                                 Foreground="#E8F6F6"
                                 BorderBrush="#00D1D1"
                                 FontFamily="Consolas"
                                 FontSize="14"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Quiz">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="StartQuizButton"
                            Content="Start Quiz"
                            Width="130"
                            HorizontalAlignment="Left"
                            Click="StartQuizButton_Click"/>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock x:Name="QuizQuestionText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <RadioButton x:Name="QuizOption1"
                                     Margin="8"
                                     Foreground="#E8F6F6"
                                     FontSize="15"/>
                        <RadioButton x:Name="QuizOption2"
                                     Margin="8"
                                     Foreground="#E8F6F6"
                                     FontSize="15"/>
                        <RadioButton x:Name="QuizOption3"
                                     Margin="8"
                                     Foreground="#E8F6F6"
                                     FontSize="15"/>
                        <RadioButton x:Name="QuizOption4"
                                     Margin="8"
                                     Foreground="#E8F6F6"
                                     FontSize="15"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Button Content="Submit Answer"
                                Width="150"
                                HorizontalAlignment="Left"
                                Click="SubmitQuizButton_Click"/>

                        <TextBox x:Name="QuizFeedbackText"
                                 Height="120"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#1B1B1B"
                                 Foreground="LightGreen"
                                 BorderBrush="#00D1D1"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Activity Log">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Refresh Log"
                            Width="130"
                            HorizontalAlignment="Left"
                            Click="RefreshLogButton_Click"/>

                    <TextBox x:Name="ActivityLogDisplay"
                             Grid.Row="1"
                             Margin="4,10,4,4"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1B1B1B"
                             Foreground="LightGreen"
                             BorderBrush="#00D1D1"
                             FontFamily="Consolas"
                             FontSize="14"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
